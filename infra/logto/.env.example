# Local development only. Use URL-safe values because the password is embedded in DB_URL.
LOGTO_POSTGRES_DB=logto
LOGTO_POSTGRES_USER=logto
LOGTO_POSTGRES_PASSWORD=logto_local_only_change_me
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# Must match the API Resource identifier configured in Logto.
OIDC_AUDIENCE=https://api.tovia.local
