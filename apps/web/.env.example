# Existing direct browser API path. Stage E does not migrate existing feature calls.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Keep development as the default. Set to oidc only for the optional Stage E flow.
NEXT_PUBLIC_WEB_AUTH_MODE=development

# Server-only BFF target and Logto Traditional Web application settings.
TOVIA_API_URL=http://localhost:8000
# LOGTO_ENDPOINT=http://auth.localhost:3001
# LOGTO_APP_ID=<traditional-web-app-id>
# LOGTO_APP_SECRET=<traditional-web-app-secret>
# LOGTO_BASE_URL=http://localhost:3000
# LOGTO_COOKIE_SECRET=<at-least-32-random-characters>
# LOGTO_API_RESOURCE=https://api.tovia.local
