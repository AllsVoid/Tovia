POSTGRES_DB=tovia
POSTGRES_USER=tovia
POSTGRES_PASSWORD=tovia_local_only
DATABASE_URL=postgresql+psycopg://tovia:tovia_local_only@localhost:5432/tovia
APP_ENV=development
# Local development identity only. Production refuses this provider.
AUTH_MODE=development
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# Reserved for the future OIDC provider. AUTH_MODE does not support oidc yet.
# OIDC_ISSUER=https://auth.example.com/oidc
# OIDC_AUDIENCE=https://api.example.com
# OIDC_JWKS_URL=https://auth.example.com/oidc/jwks
# OIDC_CLOCK_SKEW_SECONDS=30
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
